{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AriesAlex/vs-runner/master/vs-runner.schema.json",
  "title": "vs-runner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "open", "templates"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "default": "~/Documents/Projects",
      "description": "Directory containing the projects. A leading ~ expands to the home directory."
    },
    "open": {
      "$ref": "#/$defs/command",
      "description": "Command used to open a project. Available tokens: $NAME, $PROJECT_PATH, and $PROJECTS_PATH."
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/template" },
      "description": "Named project scaffolding commands."
    }
  },
  "$defs": {
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "A trusted Bun Shell command. Available tokens: `$NAME`, `$PROJECT_PATH`, and `$PROJECTS_PATH`.",
      "examples": ["bun create vite $NAME --template vue-ts", "code $PROJECT_PATH"]
    },
    "template": {
      "oneOf": [
        { "$ref": "#/$defs/command" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      ]
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/command" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "run": {
              "oneOf": [
                { "$ref": "#/$defs/command" },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/command" }
                }
              ],
              "description": "One command or a sequence of commands sharing the same working directory."
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "default": "project",
              "description": "Working directory. `project` means `$PROJECT_PATH`; other relative paths start at `$PROJECTS_PATH`. Tokens and a leading `~` are supported.",
              "examples": ["project", "$PROJECT_PATH/packages/client", "~/scratch"]
            }
          }
        }
      ]
    }
  }
}
