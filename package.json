{
  "name": "vs-runner",
  "version": "2.0.0",
  "description": "A fast, configurable project launcher for Windows.",
  "license": "ISC",
  "author": "ArieX",
  "repository": {
    "type": "git",
    "url": "https://github.com/AriesAlex/vs-runner.git"
  },
  "bin": {
    "vs": "src/main.ts",
    "vs-runner": "src/main.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts",
    "format": "oxfmt .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "check": "oxfmt --check . && oxlint && tsc --noEmit",
    "fix": "oxlint --fix && oxfmt ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
