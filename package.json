{
  "name": "vs-runner",
  "version": "2.0.0",
  "description": "A fast, configurable project launcher for Windows.",
  "type": "module",
  "bin": {
    "vs": "src/main.ts",
    "vs-runner": "src/main.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "check": "biome check . && bun run typecheck && bun run build"
  },
  "author": "ArieX",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/AriesAlex/vs-runner.git"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
