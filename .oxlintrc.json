{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "id-length": ["error", { "min": 2, "properties": "never" }]
  },
  "overrides": [
    {
      "files": ["src/prompts.ts", "src/template-runner.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
